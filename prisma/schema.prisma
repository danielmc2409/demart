generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id             String    @id @default(cuid())
  slug           String    @unique
  nome           String
  descricao      String?
  precoCentavos  Int
  categoria      String
  imagens        String[]
  ativo          Boolean   @default(true)
  variantes      Variant[]
}

model Variant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  tamanho    String
  cor        String
  estoque    Int     @default(0)
  items      OrderItem[]

  @@unique([productId, tamanho, cor])
}

enum OrderStatus {
  PENDENTE
  CONFIRMADO
  PAGO
  ENVIADO
  CANCELADO
}


model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id])
  variantId     String
  variant       Variant @relation(fields: [variantId], references: [id])
  // snapshot: se o preço/nome mudar depois, o pedido antigo não muda
  nome          String
  tamanho       String
  cor           String
  precoCentavos Int
  qtd           Int
}
enum TipoCupom {
  PERCENTUAL
  FIXO
}




model Order {
  id               String         @id @default(cuid())
  codigo           String         @unique
  status           OrderStatus    @default(PENDENTE)
  clienteNome      String
  entrega          TipoEntrega    @default(RETIRADA)
  endereco         String?
  pagamento        FormaPagamento @default(PIX)
  totalCentavos    Int
  cupomCodigo      String?
  descontoCentavos Int            @default(0)
  criadoEm         DateTime       @default(now())
  items            OrderItem[]
  clienteTelefone  String @default("")

}

enum TipoEntrega {
  RETIRADA
  ENTREGA
}

enum FormaPagamento {
  PIX
  CARTAO
  DINHEIRO
}

model Cupom {
  id             String     @id @default(cuid())
  codigo         String     @unique
  tipo           TipoCupom
  valor          Int        // PERCENTUAL: 1 a 100 | FIXO: em centavos
  minimoCentavos Int        @default(0)
  usosMaximos    Int?       // null = ilimitado
  usos           Int        @default(0)
  validoAte      DateTime?
  ativo          Boolean    @default(true)
  criadoEm       DateTime   @default(now())
  usadoPor       CupomUso[]
}

model CupomUso {
  id       String   @id @default(cuid())
  cupomId  String
  telefone String
  criadoEm DateTime @default(now())
  cupom    Cupom    @relation(fields: [cupomId], references: [id])

  @@unique([cupomId, telefone])
}