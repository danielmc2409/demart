generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id             String    @id @default(cuid())
  slug           String    @unique
  nome           String
  descricao      String?
  precoCentavos  Int
  categoria      String
  imagens        String[]
  ativo          Boolean   @default(true)
  variantes      Variant[]
}

model Variant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  tamanho    String
  cor        String
  estoque    Int     @default(0)
  items      OrderItem[]

  @@unique([productId, tamanho, cor])
}

enum OrderStatus {
  PENDENTE
  CONFIRMADO
  PAGO
  ENVIADO
  CANCELADO
}

model Order {
  id            String      @id @default(cuid())
  codigo        String      @unique
  status        OrderStatus @default(PENDENTE)
  clienteNome   String
  totalCentavos Int
  criadoEm      DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id])
  variantId     String
  variant       Variant @relation(fields: [variantId], references: [id])
  // snapshot: se o preço/nome mudar depois, o pedido antigo não muda
  nome          String
  tamanho       String
  cor           String
  precoCentavos Int
  qtd           Int
}